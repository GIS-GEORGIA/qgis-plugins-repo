{
  "_comment": "Background map services. Add your own WMS/WMTS entries here — the plugin reads this file at runtime. XYZ entries need 'url' with {x}{y}{z}; WMS/WMTS entries need 'url','layers','format','crs'. Fill the empty 'url' fields for NAPR / geoportal once you have the endpoints.",
  "services": [
    {
      "id": "osm",
      "name_en": "OpenStreetMap",
      "name_ka": "OpenStreetMap",
      "type": "xyz",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "zmin": 0,
      "zmax": 19
    },
    {
      "id": "google_satellite",
      "name_en": "Google Satellite",
      "name_ka": "Google სატელიტი",

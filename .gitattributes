# The plugin ZIPs in plugins/ are generated by tools/build.py and committed, and CI
# rebuilds them to check they are in sync. That comparison is byte-for-byte, so every
# checkout must produce identical file contents — pin line endings to LF everywhere
# rather than letting core.autocrlf give Windows contributors CRLF working trees.
* text=auto eol=lf

# Never touch these.
*.zip   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.xlsx  binary
*.shp   binary
*.shx   binary
*.dbf   binary
*.sbn   binary
*.sbx   binary
*.qix   binary
